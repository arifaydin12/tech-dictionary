rules_version = '2';

// Security rules for Tech Dictionary (Firebase mode).
// Deploy with: firebase deploy --only firestore:rules
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isUser(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    // Per-user private data, for example users/{uid}/private/progress.
    match /users/{userId}/{document=**} {
      allow read, write: if isUser(userId);
    }

    // Community words: everyone who is signed in can read them, and only the
    // author can create, change or delete a word.
    match /words/{wordId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn()
        && request.resource.data.authorId == request.auth.uid;
      allow update: if isUser(resource.data.authorId)
        && request.resource.data.authorId == resource.data.authorId;
      allow delete: if isUser(resource.data.authorId);
    }

    // Leaderboard: readable by signed-in users; everyone writes only their own row.
    match /rankings/{userId} {
      allow read: if isSignedIn();
      allow write: if isUser(userId);
    }

    // Correction suggestions: visible to the proposer and the word's author.
    // Only the author may resolve a suggestion, and only its status may change.
    match /corrections/{correctionId} {
      allow create: if isSignedIn()
        && request.resource.data.proposerId == request.auth.uid
        && request.resource.data.status == 'pending';
      allow read: if isSignedIn()
        && (resource.data.ownerId == request.auth.uid
            || resource.data.proposerId == request.auth.uid);
      allow update: if isUser(resource.data.ownerId)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status']);
      allow delete: if false;
    }

    // Everything else is denied.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
